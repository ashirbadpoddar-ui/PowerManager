# Required in production. For local development, this value may be omitted and
# the Next.js proxy uses http://127.0.0.1:8000 instead.
# Browsers always call same-origin /api/* for first-party session cookies.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Vercel Production and Preview: set this before building, then redeploy:
# NEXT_PUBLIC_API_URL=https://powermananager.onrender.com
